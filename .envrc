# One-time: install direnv, hook it into your shell, then `make direnv`.
watch_file pyproject.toml uv.lock .python-version

if ! has uv; then
  log_error "uv not found: https://docs.astral.sh/uv/getting-started/installation/"
  return 0
fi

if [[ -f .venv/Scripts/activate ]]; then
  source .venv/Scripts/activate
elif [[ -f .venv/bin/activate ]]; then
  source .venv/bin/activate
else
  log_status "no .venv yet: run make deps-install"
fi

dotenv_if_exists .env
